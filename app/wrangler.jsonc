{
  "$schema": "node_modules/wrangler/config-schema.json",
  // IntelliHorizon production: one Cloudflare Worker serves the pages (SSR), the static assets and the server API.
  // Deployed by .github/workflows/deploy.yml (see DEPLOY.md). Local tests use their own configs, not this file.
  "name": "intellihorizon",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true,

  // Static files in dist/client are served directly; every other path (including "/") goes to the SSR Worker.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // Production database, created in the owner's Cloudflare account (APAC). Migrations in ./migrations are additive.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intellihorizon",
      "database_id": "c691216d-8059-4be2-a90d-104cc24c9a20",
      "migrations_dir": "migrations"
    }
  ],

  // Uploaded files (avatars, homework photos while being read, import packs). The deploy workflow creates the bucket
  // if it doesn't exist yet; R2 must be enabled once in the Cloudflare dashboard.
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "intellihorizon-files" }
  ],

  // Non-secret settings. Secrets (API keys, admin token, email key) are set with `wrangler secret put` or in the
  // dashboard, never here. Model names were checked against each provider's documentation on 20 Nov 2026; change
  // them here or override them in the dashboard.
  "vars": {
    "HF_ENV": "production",
    "APP_SLUG": "intellihorizon",
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "OPENAI_MODEL": "gpt-6.2-sol",
    "AI_MONTHLY_BUDGET_USD": "25",
    "AI_DAILY_BUDGET_USD": "3",
    "AI_DAILY_LIMIT": "60",
    "JUDGE_AI_DAILY_LIMIT": "40",
    "JUDGE_AI_TOTAL_DAILY": "400"
  }
}
